# Example ESP32-S3 Firmware Configuration

# Provider tag applied to every sensor on this hardware bus.
provider = "rs485-esp32s3"

# Cadence (in seconds) between sensor reading and telemetry upload cycles.
poll_interval_secs = 30

[wifi]
ssid = "WIFI_SSID"
password = "WIFI_PASSWORD"

[server]
host = "192.168.1.100"
port = 3000
auth_token = "shared-secret-bearer-token"

[modbus]
baud_rate = 9600
timeout_ms = 1000
turnaround_delay_ms = 5

# Daisy-chained Modbus-RTU RS485 Sensors
[[sensors]]
external_id = "modbus_soil_slave1_temp_10cm"
category = "soil_temperature"
measurement_unit = "°C"
depth_value = 10.0
depth_unit = "cm"
slave_address = 1
function = "ReadHoldingRegisters"
register_address = 0
register_count = 1
scaling = { type = "SignedScaled", factor = 0.1 }
