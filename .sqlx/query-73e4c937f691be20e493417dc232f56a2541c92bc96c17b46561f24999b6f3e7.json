{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT m.value, m.value_text, m.measured_at\n        FROM measurements m\n        JOIN sensors s ON s.sensor_id = m.sensor_id\n        WHERE s.external_id = $1 AND s.provider = $2 AND m.measured_at < $3\n        ORDER BY m.measured_at DESC\n        LIMIT $4\n        ",
